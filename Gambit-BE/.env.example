# ─── Server ──────────────────────────────────────────────────────────────────
# Railway sets PORT automatically — leave as-is, our code reads process.env.PORT
PORT=3001
NODE_ENV=production

# ─── Supabase ────────────────────────────────────────────────────────────────
# From Supabase dashboard → Project Settings → API
SUPABASE_URL=https://<your-project>.supabase.co
SUPABASE_SERVICE_KEY=<service_role key — NOT anon key>

# ─── Blockchain (Celo Mainnet, chainId 42220) ────────────────────────────────
CELO_RPC_URL=https://forno.celo.org

# Server wallet — sends on-chain tx (needs CELO for gas + funding)
SERVER_WALLET_PRIVATE_KEY=0x<64 hex chars>

# Oracle wallet — signs match results / puzzle vouchers (off-chain, no gas needed)
# Address must match what was granted ORACLE_ROLE on GambitHub at deploy time
ORACLE_PRIVATE_KEY=0x<64 hex chars>

# ─── Token (CELO ERC20 wrapper on Celo Mainnet) ──────────────────────────────
CUSD_ADDRESS=0x471EcE3750Da237f93B8E339c536989b8978a438

# ─── Deployed contracts (Celo Mainnet) ───────────────────────────────────────
GAMBIT_HUB_ADDRESS=0x992DA8B79158F269513EF27675035c585d07B047
MATCH_ESCROW_ADDRESS=0x27ec815b4022Fb34a3e78DdCC1b8e62406c556fc
PUZZLE_POOL_ADDRESS=0x3B9A1A0d6ab2AB846661Ee0F5a1DB93EEc134054
DAILY_PUZZLE_POOL_ADDRESS=0x859D1b6e685b8763ceDa79B17fB3aF7E2A4958e8
CLUB_VAULT_ADDRESS=0x08cb38f973E5f964e8662624660b3F3442337079
GAMBIT_BADGES_ADDRESS=0x7F554B60cC46198213e57f2C667d83ef480981C3

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=<random 64 chars>

# ─── Game config ─────────────────────────────────────────────────────────────
STOCKFISH_PATH=./stockfish-wasm
GAME_TIMEOUT_MS=300000
DISCONNECT_TIMEOUT_MS=60000
CLOCK_SYNC_INTERVAL_MS=10000
